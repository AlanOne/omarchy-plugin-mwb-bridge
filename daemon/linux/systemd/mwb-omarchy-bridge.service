[Unit]
Description=MWB Omarchy Bridge (Mouse Without Borders client/server daemon)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=%h/.config/omarchy/plugins/io.github.alanone.mwb-bridge/daemon/target/release/daemon
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
